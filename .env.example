# 이 파일을 복사해 .env를 만들고 값을 채워요. .env는 커밋하지 않아요.
# 값은 따옴표 없이 써요.

# 서버
PORT=8080

# DB. 로컬은 그대로 두면 돼요(backend/compose.yaml 의 MySQL과 같은 값)
DATABASE_URL=jdbc:mysql://localhost:3307/local_demand
DB_USERNAME=local_demand
DB_PASSWORD=local_demand

# 프론트 주소(쉼표로 구분). 프론트를 배포하면 그 주소도 더해요
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 카카오 로그인 (MVP에서는 안 써요. 시간이 남으면 붙여요)
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=

# AI (모델이 정해지면 이름을 맞춰 바꿔요). 키는 서버에만 두고 브라우저로 보내지 않아요
AI_API_KEY=

# 시연용 로그인(POST /auth/demo). 운영에서는 false
DEMO_LOGIN_ENABLED=true

# 지도 (브라우저에서 쓰는 지도 키는 꼭 도메인 제한을 걸어요)
MAP_JS_KEY=
