# 이 파일을 복사해 .env를 만들고 값을 채워요. .env는 커밋하지 않아요.
# 값은 따옴표 없이 써요.

# 서버
PORT=8080

# DB. 로컬은 그대로 두면 돼요(backend/compose.yaml 의 MySQL과 같은 값)
DATABASE_URL=jdbc:mysql://localhost:3307/local_demand
DB_USERNAME=local_demand
DB_PASSWORD=local_demand

# 프론트 주소(쉼표로 구분). 프론트를 배포하면 그 주소도 더해요
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 카카오 로그인 (MVP에서는 안 써요. 시간이 남으면 붙여요)
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=

# AI. fake 면 키 없이 낱말 맞추기로 대신해요(요약은 기본 문장). 키는 서버에만 두고 브라우저로 보내지 않아요
# openai 로 바꾸고 키를 넣으면 OpenAI 를 불러요(모델 기본값 gpt-6-luna, reasoning_effort none)
AI_PROVIDER=fake
AI_API_KEY=

# 시연용 로그인(POST /auth/demo). 운영에서는 false
DEMO_LOGIN_ENABLED=true

# 지도 (브라우저에서 쓰는 지도 키는 꼭 도메인 제한을 걸어요)
MAP_JS_KEY=

# 입장권(JWT) 도장 키. 32바이트 이상 무작위 값을 base64로 넣어요(만드는 법: backend/README.md).
# 비워 두면 서버가 켜질 때마다 임시 키를 만들어요(로컬용). 배포 서버에는 꼭 넣어요.
JWT_SECRET=

# 시연용 예시 데이터(시연 계정, 구성동 과일 29명 등)를 서버가 켜질 때 넣어요. 발표 서버에서만 true
# 켜 두면 로컬 테스트도 .env 를 읽어서 시드가 들어가요(테스트는 시드가 있어도 돌아가게 짜 뒀어요)
DEMO_SEED_ENABLED=false
