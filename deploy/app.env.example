# 배포 서버의 환경변수. setup-server.sh 가 서버의 /etc/local-demand-map/app.env 로 복사하고,
# 비어 있는 DB_PASSWORD·DB_ROOT_PASSWORD·JWT_SECRET 은 서버에서 직접 만들어 채워요.
# 진짜 값은 이 파일(.example)에 넣지 않고, 단톡방·커밋·캡처에도 올리지 않아요. 값은 따옴표 없이 써요.
# 바꾼 뒤에는: sudo systemctl restart local-demand-map

# 서버. 8080은 서버 안에서만 열고, 밖에서는 nginx(80·443)로만 들어와요
PORT=8080
SERVER_ADDRESS=127.0.0.1
# nginx 가 붙여 주는 X-Forwarded-* 를 믿어요(https 주소를 제대로 알아요)
SERVER_FORWARD_HEADERS_STRATEGY=native

# DB (compose.prod.yaml 의 MySQL)
DATABASE_URL=jdbc:mysql://127.0.0.1:3306/local_demand
DB_USERNAME=local_demand
DB_PASSWORD=
DB_ROOT_PASSWORD=

# 입장권(JWT) 도장 키. 비워 두면 setup-server.sh 가 만들어요(서버를 다시 켜도 토큰이 유지돼요)
JWT_SECRET=

# 프론트 주소. 같은 서버(nginx)에서 나가는 화면은 없어도 되고,
# 프론트 개발자가 자기 컴퓨터(localhost:5173)에서 이 서버 API를 부를 수 있게 열어 둬요
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI. fake 면 키 없이 낱말 맞추기. openai 로 바꾸면 AI_API_KEY 가 꼭 있어야 서버가 켜져요
AI_PROVIDER=fake
AI_API_KEY=

# 시연: 시연 로그인과 예시 데이터(구성동 과일 29명 등). 서버를 다시 켤 때마다 시연 시작 상태로 돌아가요
DEMO_LOGIN_ENABLED=true
DEMO_SEED_ENABLED=true
